{
  "name": "postgres-sink-connector",
  "config": {
    "connector.class": "io.debezium.connector.jdbc.JdbcSinkConnector",
    "tasks.max": "1",
    "topics.regex": "oracle_cdc\\.C__DBZUSER\\.(?!USER_ROLES$|EVENTS_LOG$).*",
    "connection.url": "jdbc:postgresql://postgres:5432/target_db",
    "connection.username": "postgres",
    "connection.password": "postgres",
    "insert.mode": "upsert",
    "primary.key.mode": "record_key",
    "delete.enabled": "false",
    "schema.evolution": "none",
    "transforms": "stripPrefix",
    "transforms.stripPrefix.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.stripPrefix.regex": "oracle_cdc\\.C__DBZUSER\\.(.*)",
    "transforms.stripPrefix.replacement": "$1"
  }
}
